{
  "name": "@anchorproposal/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @anchorproposal/shared build && tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test:templates": "ts-node --transpile-only template-qa.ts",
    "test:generations": "pnpm build && node --test test/manual-generation.test.cjs",
    "test:warnings": "pnpm build && node --test test/warning-context.test.cjs",
    "test:prompts": "pnpm build && node --test test/prompt-default.test.cjs",
    "test:ai-key": "pnpm build && node --test test/ai-key.test.cjs test/manual-generation.test.cjs",
    "test:unit": "pnpm build && node --test test/*.test.cjs",
    "test:functional": "pnpm build && node test/functional-db.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\""
  },
  "dependencies": {
    "@anchorproposal/shared": "workspace:*",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "docx": "^9.1.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^23.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}

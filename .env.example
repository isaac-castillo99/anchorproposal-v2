DATABASE_URL=postgresql://anchorproposal:anchorproposal@localhost:5432/anchorproposal
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random
DEEPSEEK_API_KEY=
STORAGE_PATH=./storage
# Optional absolute directory for release.json and the Windows executable.
# Default: apps/api/storage/desktop (independent of the API working directory).
DESKTOP_RELEASE_DIR=
API_PORT=3001
# Local direct API, or "/backend" when using Next.js rewrite (single ngrok tunnel)
NEXT_PUBLIC_API_URL=/backend
APP_WEB_URL=http://localhost:3000
# Comma-separated origins (ngrok HTTPS + local). Localhost is always allowed by the API.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Next.js rewrite target for /backend → API (IPv4 loopback avoids Windows [::1] errors)
API_PROXY_TARGET=http://127.0.0.1:3001
# Optional SMTP — if unset, OTP codes and reset links are logged to the API console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AnchorProposal <noreply@anchorproposal.local>
SMTP_SECURE=false

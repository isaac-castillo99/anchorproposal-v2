{
  "name": "anchorproposal",
  "private": true,
  "scripts": {
    "desktop": "pnpm --filter @anchorproposal/desktop start",
    "build:desktop": "pnpm --filter @anchorproposal/desktop build",
    "package:desktop": "pnpm --filter @anchorproposal/desktop package:win",
    "publish:desktop": "node scripts/publish-desktop.cjs",
    "dev:web": "pnpm --filter @anchorproposal/web dev",
    "dev:api": "pnpm --filter @anchorproposal/api dev",
    "dev": "pnpm --parallel --filter @anchorproposal/web --filter @anchorproposal/api run dev",
    "share": "powershell -ExecutionPolicy Bypass -File ./scripts/start-share.ps1",
    "build": "pnpm --filter @anchorproposal/shared build && pnpm --filter @anchorproposal/api build && pnpm --filter @anchorproposal/web build",
    "build:api": "pnpm --filter @anchorproposal/shared build && pnpm --filter @anchorproposal/api build",
    "build:web": "pnpm --filter @anchorproposal/web build",
    "start:api": "pnpm --filter @anchorproposal/api start",
    "start:web": "pnpm --filter @anchorproposal/web start",
    "start": "pnpm --parallel --filter @anchorproposal/web --filter @anchorproposal/api run start",
    "lint": "pnpm --filter @anchorproposal/web lint",
    "db:migrate": "pnpm --filter @anchorproposal/api db:migrate",
    "db:seed": "pnpm --filter @anchorproposal/api db:seed",
    "db:generate": "pnpm --filter @anchorproposal/api db:generate",
    "test": "pnpm --filter @anchorproposal/shared build && node scripts/test-unit.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
